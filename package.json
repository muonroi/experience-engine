{
  "name": "@muonroi/experience-engine",
  "version": "0.8.2",
  "description": "CLI installer and server runtime for Experience Engine",
  "license": "MIT",
  "type": "commonjs",
  "bin": {
    "experience-engine": "bin/experience-engine.js",
    "exp-engine": "bin/experience-engine.js",
    "exp-mcp": "bin/exp-mcp.js",
    "qdrant-find": "tools/qdrant-find.js"
  },
  "files": [
    "api/",
    "bin/",
    "lib/",
    "mcp/",
    ".experience/activity-watch.js",
    ".experience/exp-bootstrap.sh",
    ".experience/exp-client-drain.js",
    ".experience/exp-feedback",
    ".experience/exp-feedback.js",
    ".experience/exp-recall.js",
    ".experience/exp-health-last",
    ".experience/exp-open-pane",
    ".experience/exp-pane-bottom",
    ".experience/exp-pane-left",
    ".experience/exp-pane-right",
    ".experience/exp-shell-init.sh",
    ".experience/exp-watch",
    ".experience/experience-core.js",
    ".experience/extract-compact.js",
    ".experience/health-check.sh",
    ".experience/interceptor-post.js",
    ".experience/interceptor-prompt.js",
    ".experience/interceptor-session.js",
    ".experience/interceptor.js",
    ".experience/judge-worker.js",
    ".experience/posttool-batch-hook.js",
    ".experience/remote-client.js",
    ".experience/setup-thin-client.sh",
    ".experience/setup.ps1",
    ".experience/setup.sh",
    ".experience/src/",
    ".experience/stop-extractor.js",
    ".experience/sync-install.sh",
    ".experience/tools/bulk-extract.js",
    ".experience/tools/import-memory.js",
    "tools/exp-demote.js",
    "tools/exp-dogfood-loop.js",
    "tools/exp-gates.js",
    "tools/exp-holdout-harness.js",
    "tools/exp-portable-backup.js",
    "tools/exp-portable-restore.js",
    "tools/exp-replay-sessions.js",
    "tools/exp-server-maintain.js",
    "tools/exp-stats.js",
    "tools/exp-outcome-baseline.js",
    "tools/exp-engine-lift.js",
    "tools/exp-beta-replay.js",
    "tools/qdrant-find.js",
    "tools/experience-bulk-seed.js",
    "fixtures/holdout/",
    "server.js",
    "README.md",
    "LICENSE",
    "docker-compose.yml",
    "Dockerfile",
    "docker-entrypoint.sh",
    "demo.svg",
    "demo.tape",
    "demo.yml"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:unit": "node --test --test-concurrency=1 tests/runtime/*.test.js",
    "test:tools": "node --test --test-concurrency=1 tests/tools/*.test.js",
    "test:holdout": "node --test tests/tools/exp-holdout-harness.test.js tests/tools/exp-holdout-fixtures.test.js",
    "test:health": "node --test tests/runtime/health-check.test.js tests/runtime/setup.test.js",
    "test:server": "node tests/tools/server-api.test.js",
    "test:ci": "npm test && npm run test:unit && npm run test:tools",
    "test:coverage": "npx c8 --lines 60 --functions 50 --branches 40 --reporter=text --reporter=html --report-dir=coverage node --test --test-concurrency=1 tests/*.test.js tests/runtime/*.test.js tests/tools/*.test.js",
    "replay:holdout": "node tools/exp-holdout-harness.js --fixture fixtures/holdout --json",
    "typecheck": "npm i --no-save --no-package-lock --no-audit --no-fund typescript@5 @types/node@22 && tsc -p jsconfig.json",
    "check:syntax": "node scripts/check-syntax.js",
    "lint": "npx eslint server.js api/ .experience/experience-core.js .experience/src/",
    "format": "npx prettier --write server.js api/ .experience/experience-core.js .experience/src/",
    "format:check": "npx prettier --check server.js api/ .experience/experience-core.js .experience/src/",
    "version": "node scripts/sync-openapi-version.js && git add docs/openapi.yaml",
    "changelog": "node scripts/generate-changelog.js",
    "seed:catalog": "node scripts/seed-catalog.js",
    "config:encrypt": "node scripts/config-encrypt.js encrypt",
    "config:status": "node scripts/config-encrypt.js status",
    "pack:dry-run": "npm pack --dry-run"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muonroi/experience-engine.git"
  },
  "homepage": "https://github.com/muonroi/experience-engine#readme",
  "bugs": {
    "url": "https://github.com/muonroi/experience-engine/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "memory",
    "experience",
    "codex",
    "claude",
    "gemini",
    "antigravity",
    "qdrant"
  ]
}
